# Public values (safe in the browser): Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Shown on the Contact legal page (PD13)
VITE_SUPPORT_EMAIL=
# Secrets never go here. Server-side ones live in Supabase secrets:
#   RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET   (supabase secrets set NAME=value)

# Local test stack only (npm run db:local, db:seed, test:e2e). Copy to .env.e2e and .env.local (git-ignored) and fill in:
#   .env.e2e:   QA_PASSWORD=<any local value>  and the two values printed by `supabase start`:
#               VITE_SUPABASE_URL=http://127.0.0.1:54321   VITE_SUPABASE_PUBLISHABLE_KEY=<local anon key>
#   supabase/.env.local (for `supabase functions serve api --env-file supabase/.env.local`):
#               PROVIDER_MODE=fake  APP_ENV=local  RAZORPAY_KEY_ID=rzp_fake_local  RAZORPAY_KEY_SECRET=<any>  RAZORPAY_WEBHOOK_SECRET=<any>
#               CRON_SECRET=<any>  SITE_URL=http://localhost:5173
