{
  "name": "artist-marketplace",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "formik": "^2.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-lazy-load-image-component": "^1.6.3",
    "react-router-dom": "^7.4.1",
    "yup": "^1.6.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "node scripts/check-legal.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "test": "vitest run",
    "test:schema": "node supabase/schema.test.mjs",
    "test:e2e": "playwright test",
    "db:local": "supabase start",
    "db:seed": "supabase db reset && node e2e/helpers/seed.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.5.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
